{
  "seed": 1,
  "device": "auto",
  "iterations": 1000,
  "traversals_per_player": 128,
  "traversal_batch_size": 32,
  "buffer_capacity": 2000000,
  "buffer_directory": null,
  "train_steps": 1200,
  "minibatch_size": 1024,
  "learning_rate": 0.0003,
  "max_grad_norm": 1.0,
  "reinitialize": false,
  "fallback": "softmax",
  "snapshot_every": 1,
  "checkpoint_every": 10,
  "out_dir": "runs/sd_cfr_hunl",
  "max_traversal_nodes": null,
  "model": {
    "d_model": 128,
    "nhead": 4,
    "num_layers": 4,
    "dim_feedforward": 256,
    "dropout": 0.1,
    "max_seq_len": 64
  },
  "separate_player_models": false,
  "position_conditioning": true,
  "regret_target_scale": 100.0,
  "loss": "huber",
  "huber_beta": 1.0,
  "preflop_action_guard": true,
  "amp_dtype": "bfloat16",
  "fused_optimizer": true,
  "allow_tf32": true,
  "spr_action_guard": true,
  "guard_max_pot_ratio": 3.0
}
