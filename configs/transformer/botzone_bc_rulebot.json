{
  "name": "botzone_bc_rulebot",
  "seed": 42,
  "device": "auto",
  "rollout_device": "cpu",
  "encoder": "transformer",
  "model": {
    "d_model": 128,
    "nhead": 4,
    "num_layers": 4,
    "dim_feedforward": 256,
    "dropout": 0.1,
    "max_seq_len": 64
  },
  "ppo": {
    "lr": 0.001,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "clip_eps": 0.2,
    "value_clip_eps": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "epochs": 8,
    "minibatch_size": 256,
    "rollout_steps": 128,
    "num_envs": 8,
    "adam_eps": 1e-05
  },
  "pool": {
    "max_size": 8,
    "selfplay_prob": 0.25,
    "random_prob": 0.1,
    "snapshot_every": 10,
    "sampling": "pfsp"
  },
  "train": {
    "num_updates": 8,
    "checkpoint_every": 50,
    "log_every": 1,
    "eval_every": 25,
    "eval_hands": 20,
    "out_dir": "runs/bc_rulebot_train",
    "amp": false,
    "checkpoint_dir": "runs/bc_rulebot_train",
    "keep_last": 20
  },
  "env": {
    "backend": "botzone",
    "big_blind": 100,
    "small_blind": 50,
    "starting_stack": 20000,
    "mask_free_fold": true
  }
}
